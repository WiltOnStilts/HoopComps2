{
  "name": "dynasty-draft",
  "version": "1.0.0",
  "description": "DynastyDraft — daily basketball team-building game",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "test": "node scripts/smoke-test.mjs",
    "import:rosters": "node scripts/import-bbgm-rosters.mjs",
    "build:rosters": "node scripts/import-bbgm-rosters.mjs && node scripts/generate-rosters.mjs",
    "rerate:rosters": "node scripts/rerate-imported.mjs && node scripts/generate-rosters.mjs",
    "rebuild:ratings": "node scripts/full-ratings-rebuild.mjs --fetch-nba",
    "rebuild:ratings:fast": "node scripts/full-ratings-rebuild.mjs",
    "build:rosters:full": "node scripts/import-bbgm-rosters.mjs && .venv/bin/python scripts/fetch-nba-rosters.py && node scripts/generate-rosters.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
