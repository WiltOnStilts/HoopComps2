# Copy to .env — then: npm install && npm start

# Required for multi-user accounts in production
JWT_SECRET=change-me-to-a-long-random-string

# Optional branding
SITE_NAME=HoopComps

# eBay — https://developer.ebay.com/my/keys (Production keyset)
EBAY_APP_ID=
EBAY_CLIENT_SECRET=

# Optional
PRICECHARTING_TOKEN=
OPENAI_API_KEY=
# Used for AI collection insights and social comment moderation (7-day auto-ban on violations)

# Card of the Day — featured collectors (comma-separated). Same spotlight for all users.
# Defaults to builtwilt@icloud.com when unset.
SPOTLIGHT_USER_EMAILS=builtwilt@icloud.com
# SPOTLIGHT_USER_IDS=acd960d3-7b96-4320-ab5a-0fb869322416

PORT=3847
