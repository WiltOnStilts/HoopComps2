# Copy to .env — then: npm install && npm start

# Required for multi-user accounts in production
JWT_SECRET=change-me-to-a-long-random-string

# Neon Postgres — https://neon.tech (free tier). Survives redeploys.
# Paste your connection string from Neon dashboard → Connect
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Local fallback only (when DATABASE_URL is unset)
# USE_FILE_STORE=1

# Optional branding
SITE_NAME=HoopComps

# eBay — https://developer.ebay.com/my/keys (Production keyset)
EBAY_APP_ID=
EBAY_CLIENT_SECRET=

# Optional
PRICECHARTING_TOKEN=
OPENAI_API_KEY=
# Optional — AI collection insights + comment moderation

# Card of the Day — featured collectors (comma-separated). Same spotlight for all users.
# Defaults to builtwilt@icloud.com when unset.
SPOTLIGHT_USER_EMAILS=builtwilt@icloud.com
# SPOTLIGHT_USER_IDS=acd960d3-7b96-4320-ab5a-0fb869322416

PORT=3847
